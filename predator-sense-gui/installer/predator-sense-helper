#!/bin/bash

# The installed helper always operates on the real sysfs.  An unprivileged
# process may point it at a fixture tree for integration tests; pkexec/sudo
# executions deliberately ignore this override.
SYSFS_ROOT=/sys
if [ "$EUID" -ne 0 ] && [ -n "${PREDATOR_SENSE_HELPER_TEST_ROOT:-}" ]; then
  SYSFS_ROOT=${PREDATOR_SENSE_HELPER_TEST_ROOT%/}
fi

fail() {
  echo "predator-sense-helper: $*" >&2
  return 1
}

write_attr() {
  local label=$1 value=$2 path=$3 output rc
  output=$( { printf '%s\n' "$value" > "$path"; } 2>&1)
  rc=$?
  if [ "$rc" -ne 0 ]; then
    fail "$label: cannot write '$value' to $path${output:+: $output}"
    return 1
  fi
}

read_attr() {
  local label=$1 path=$2 value
  if [ ! -r "$path" ]; then
    fail "$label: cannot read $path"
    return 1
  fi
  IFS= read -r value < "$path" || true
  printf '%s' "$value"
}

cpu_policy_dirs() {
  local path name
  for path in "$SYSFS_ROOT"/devices/system/cpu/cpufreq/policy*; do
    [ -d "$path" ] || continue
    name=${path##*/}
    [[ $name =~ ^policy[0-9]+$ ]] && printf '%s\n' "$path"
  done
}

lock_cpu_profile() {
  local lock_path=/run/lock/predator-sense-cpu-profile.lock
  [ "$SYSFS_ROOT" = /sys ] || lock_path="$SYSFS_ROOT/predator-sense-cpu-profile.lock"
  command -v flock >/dev/null 2>&1 || {
    fail "flock is required to serialize CPU profile changes"
    return 1
  }
  exec 9> "$lock_path" || {
    fail "cannot open CPU profile lock $lock_path"
    return 1
  }
  flock -w 10 9 || {
    fail "timed out waiting for another CPU profile change"
    return 1
  }
}

intel_pstate_hwp_active() {
  local status_path="$SYSFS_ROOT/devices/system/cpu/intel_pstate/status"
  local policy driver
  [ "$(read_attr intel-pstate-status "$status_path" 2>/dev/null)" = active ] || return 1
  for policy in "${CPU_POLICIES[@]}"; do
    driver=$(read_attr scaling-driver "$policy/scaling_driver" 2>/dev/null) || return 1
    [ "$driver" = intel_pstate ] || return 1
    [ -e "$policy/energy_performance_preference" ] || return 1
  done
  [ "${#CPU_POLICIES[@]}" -gt 0 ]
}

validate_cpu_profile_args() {
  case "$TARGET_GOVERNOR" in
    powersave|performance) ;;
    *) fail "invalid CPU governor '$TARGET_GOVERNOR'"; return 1 ;;
  esac
  case "$TARGET_EPP" in
    skip|0|default|performance|balance_performance|balance_power|power) ;;
    *) fail "invalid EPP '$TARGET_EPP'"; return 1 ;;
  esac
  case "$TARGET_NO_TURBO" in
    skip|0|1) ;;
    *) fail "invalid no_turbo value '$TARGET_NO_TURBO'"; return 1 ;;
  esac
  if [ "$TARGET_MIN_PERF" != skip ]; then
    if ! [[ $TARGET_MIN_PERF =~ ^[0-9]+$ ]] || [ "$TARGET_MIN_PERF" -gt 100 ]; then
      fail "invalid min_perf_pct '$TARGET_MIN_PERF'"
      return 1
    fi
  fi
}

preflight_cpu_profile() {
  local policy available
  mapfile -t CPU_POLICIES < <(cpu_policy_dirs)
  if [ "${#CPU_POLICIES[@]}" -eq 0 ]; then
    fail "no CPU frequency policies found under $SYSFS_ROOT/devices/system/cpu/cpufreq"
    return 1
  fi

  for policy in "${CPU_POLICIES[@]}"; do
    [ -e "$policy/scaling_governor" ] || {
      fail "missing scaling_governor in $policy"
      return 1
    }
    if [ -r "$policy/scaling_available_governors" ]; then
      available=$(read_attr available-governors "$policy/scaling_available_governors") || return 1
      case " $available " in
        *" $TARGET_GOVERNOR "*) ;;
        *) fail "governor '$TARGET_GOVERNOR' is not available in $policy"; return 1 ;;
      esac
    fi

    if [ "$TARGET_EPP" != skip ]; then
      [ -e "$policy/energy_performance_preference" ] || {
        fail "missing energy_performance_preference in $policy"
        return 1
      }
      if [ "$TARGET_EPP" != 0 ] && [ -r "$policy/energy_performance_available_preferences" ]; then
        available=$(read_attr available-epp "$policy/energy_performance_available_preferences") || return 1
        case " $available " in
          *" $TARGET_EPP "*) ;;
          *) fail "EPP '$TARGET_EPP' is not available in $policy"; return 1 ;;
        esac
      fi
    fi
  done

  NO_TURBO_PATH="$SYSFS_ROOT/devices/system/cpu/intel_pstate/no_turbo"
  MIN_PERF_PATH="$SYSFS_ROOT/devices/system/cpu/intel_pstate/min_perf_pct"
  if [ "$TARGET_NO_TURBO" != skip ] && [ ! -e "$NO_TURBO_PATH" ]; then
    fail "missing $NO_TURBO_PATH"
    return 1
  fi
  if [ "$TARGET_MIN_PERF" != skip ] && [ ! -e "$MIN_PERF_PATH" ]; then
    fail "missing $MIN_PERF_PATH"
    return 1
  fi
}

snapshot_cpu_profile() {
  local policy value
  OLD_GOVERNORS=()
  OLD_EPPS=()
  for policy in "${CPU_POLICIES[@]}"; do
    value=$(read_attr scaling-governor "$policy/scaling_governor") || return 1
    OLD_GOVERNORS+=("$value")
    if [ -e "$policy/energy_performance_preference" ]; then
      value=$(read_attr epp "$policy/energy_performance_preference") || return 1
      OLD_EPPS+=("$value")
    else
      OLD_EPPS+=(skip)
    fi
  done

  OLD_NO_TURBO=skip
  OLD_MIN_PERF=skip
  if [ -e "$NO_TURBO_PATH" ]; then
    OLD_NO_TURBO=$(read_attr no-turbo "$NO_TURBO_PATH") || return 1
  fi
  if [ -e "$MIN_PERF_PATH" ]; then
    OLD_MIN_PERF=$(read_attr min-perf "$MIN_PERF_PATH") || return 1
  fi
}

rollback_attr() {
  local label=$1 value=$2 path=$3 output rc
  output=$( { printf '%s\n' "$value" > "$path"; } 2>&1)
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "predator-sense-helper: rollback failed for $label at $path${output:+: $output}" >&2
    return 1
  fi
}

rollback_cpu_profile() {
  local i policy old_governor old_epp rollback_failed=0 intel_hwp=0
  intel_pstate_hwp_active && intel_hwp=1
  for i in "${!CPU_POLICIES[@]}"; do
    policy=${CPU_POLICIES[$i]}
    old_governor=${OLD_GOVERNORS[$i]}
    old_epp=${OLD_EPPS[$i]}

    if [ "$old_governor" = performance ] && [ "$intel_hwp" -eq 1 ]; then
      # Selecting this policy is itself the kernel ABI for restoring forced
      # EPP 0.  Do not require numeric EPP writes, which some HWP/EPB-backed
      # systems do not expose even though named preferences are available.
      rollback_attr scaling-governor "$old_governor" "$policy/scaling_governor" || rollback_failed=1
    else
      rollback_attr scaling-governor "$old_governor" "$policy/scaling_governor" || rollback_failed=1
      [ "$old_epp" = skip ] || rollback_attr epp "$old_epp" "$policy/energy_performance_preference" || rollback_failed=1
    fi
  done
  [ "$OLD_NO_TURBO" = skip ] || rollback_attr no-turbo "$OLD_NO_TURBO" "$NO_TURBO_PATH" || rollback_failed=1
  [ "$OLD_MIN_PERF" = skip ] || rollback_attr min-perf "$OLD_MIN_PERF" "$MIN_PERF_PATH" || rollback_failed=1
  return "$rollback_failed"
}

apply_or_rollback() {
  if ! write_attr "$@"; then
    echo "predator-sense-helper: rolling back CPU profile" >&2
    rollback_cpu_profile || echo "predator-sense-helper: CPU profile rollback was incomplete" >&2
    return 1
  fi
}

verify_cpu_profile() {
  local policy actual
  for policy in "${CPU_POLICIES[@]}"; do
    actual=$(read_attr scaling-governor "$policy/scaling_governor") || return 1
    [ "$actual" = "$TARGET_GOVERNOR" ] || {
      fail "verification failed for $policy/scaling_governor: expected '$TARGET_GOVERNOR', got '$actual'"
      return 1
    }

    if [ "$TARGET_EPP" != skip ]; then
      # In active intel_pstate HWP performance mode the kernel forces raw EPP
      # 0.  Model-specific EPP tables may render that value as "default"
      # instead of "performance", so the governor is the authoritative
      # readback for this one kernel-defined combination.
      if ! { [ "$TARGET_GOVERNOR" = performance ] && [ "$TARGET_EPP" = 0 ] && intel_pstate_hwp_active; }; then
        actual=$(read_attr epp "$policy/energy_performance_preference") || return 1
        [ "$actual" = "$TARGET_EPP" ] || {
          fail "verification failed for $policy/energy_performance_preference: expected '$TARGET_EPP', got '$actual'"
          return 1
        }
      fi
    fi
  done

  if [ "$TARGET_NO_TURBO" != skip ]; then
    actual=$(read_attr no-turbo "$NO_TURBO_PATH") || return 1
    [ "$actual" = "$TARGET_NO_TURBO" ] || {
      fail "verification failed for $NO_TURBO_PATH: expected '$TARGET_NO_TURBO', got '$actual'"
      return 1
    }
  fi
  if [ "$TARGET_MIN_PERF" != skip ]; then
    actual=$(read_attr min-perf "$MIN_PERF_PATH") || return 1
    [ "$actual" = "$TARGET_MIN_PERF" ] || {
      fail "verification failed for $MIN_PERF_PATH: expected '$TARGET_MIN_PERF', got '$actual'"
      return 1
    }
  fi
}

apply_cpu_profile() {
  TARGET_GOVERNOR=$1
  TARGET_EPP=$2
  TARGET_NO_TURBO=$3
  TARGET_MIN_PERF=$4

  validate_cpu_profile_args || return 1
  preflight_cpu_profile || return 1
  snapshot_cpu_profile || return 1

  local policy kernel_forces_epp_zero=0
  if [ "$TARGET_GOVERNOR" = performance ] && [ "$TARGET_EPP" = 0 ] && intel_pstate_hwp_active; then
    kernel_forces_epp_zero=1
  fi
  if [ "$TARGET_GOVERNOR" = performance ]; then
    # Active intel_pstate HWP guarantees EPP 0 when this governor is selected.
    # Rely on that policy instead of requiring the optional numeric EPP ABI.
    # Other drivers still receive their requested EPP before the governor.
    if [ "$TARGET_EPP" != skip ] && [ "$kernel_forces_epp_zero" -eq 0 ]; then
      for policy in "${CPU_POLICIES[@]}"; do
        apply_or_rollback epp "$TARGET_EPP" "$policy/energy_performance_preference" || return 1
      done
    fi
    for policy in "${CPU_POLICIES[@]}"; do
      apply_or_rollback scaling-governor "$TARGET_GOVERNOR" "$policy/scaling_governor" || return 1
    done
  else
    # Leaving performance first restores an EPP-writable governor.
    for policy in "${CPU_POLICIES[@]}"; do
      apply_or_rollback scaling-governor "$TARGET_GOVERNOR" "$policy/scaling_governor" || return 1
    done
    if [ "$TARGET_EPP" != skip ]; then
      for policy in "${CPU_POLICIES[@]}"; do
        apply_or_rollback epp "$TARGET_EPP" "$policy/energy_performance_preference" || return 1
      done
    fi
  fi

  [ "$TARGET_NO_TURBO" = skip ] || apply_or_rollback no-turbo "$TARGET_NO_TURBO" "$NO_TURBO_PATH" || return 1
  [ "$TARGET_MIN_PERF" = skip ] || apply_or_rollback min-perf "$TARGET_MIN_PERF" "$MIN_PERF_PATH" || return 1

  if ! verify_cpu_profile; then
    echo "predator-sense-helper: rolling back CPU profile after failed verification" >&2
    rollback_cpu_profile || echo "predator-sense-helper: CPU profile rollback was incomplete" >&2
    return 1
  fi
}

# Locate the facer/acer hwmon dir that exposes pwm* (kernel >= 6.14)
acer_hwmon() {
  for d in /sys/class/hwmon/hwmon*; do
    n=$(cat "$d/name" 2>/dev/null)
    if [ "$n" = "acer" ] && [ -e "$d/pwm1" ]; then echo "$d"; return 0; fi
  done
  return 1
}

case "$1" in
  apply-cpu-profile)
    [ "$#" -eq 5 ] || { fail "usage: apply-cpu-profile GOVERNOR EPP|skip NO_TURBO|skip MIN_PERF|skip"; exit 1; }
    lock_cpu_profile || exit 1
    apply_cpu_profile "$2" "$3" "$4" "$5"
    ;;
  # Kept for compatibility with older GUI binaries during upgrades.
  set-governor) for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo "$2" > "$c" 2>/dev/null; done ;;
  set-epp) for c in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo "$2" > "$c" 2>/dev/null; done ;;
  set-gpu-power) nvidia-smi -pm 1 2>/dev/null; nvidia-smi -pl "$2" 2>/dev/null ;;
  set-no-turbo) echo "$2" > /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null ;;
  set-min-perf) echo "$2" > /sys/devices/system/cpu/intel_pstate/min_perf_pct 2>/dev/null ;;
  fan-auto) python3 -c "f=open('/dev/ec','rb+');f.seek(0x21);f.write(bytes([0x50]));f.seek(0x22);f.write(bytes([0x54]));f.close()" 2>/dev/null ;;
  fan-max) python3 -c "f=open('/dev/ec','rb+');f.seek(0x21);f.write(bytes([0x60]));f.seek(0x22);f.write(bytes([0x58]));f.close()" 2>/dev/null ;;
  fan-mode-read) python3 -c "f=open('/dev/ec','rb');f.seek(0x21);b1=ord(f.read(1));f.close();print('max' if b1==0x60 else ('auto' if b1==0x50 else 'unknown'))" 2>/dev/null ;;
  coolboost) python3 -c "f=open('/dev/ec','rb+');f.seek(0x10);f.write(bytes([int('$2')]));f.close()" 2>/dev/null ;;
  coolboost-read) python3 -c "f=open('/dev/ec','rb');f.seek(0x10);print(ord(f.read(1)));f.close()" 2>/dev/null ;;
  bat-limit) if [ "$2" = "1" ]; then echo 80 > /sys/class/power_supply/BAT1/charge_control_end_threshold 2>/dev/null; else echo 100 > /sys/class/power_supply/BAT1/charge_control_end_threshold 2>/dev/null; fi ;;
  bat-limit-read) VAL=$(cat /sys/class/power_supply/BAT1/charge_control_end_threshold 2>/dev/null || echo 100); [ "$VAL" -le 80 ] && echo 1 || echo 0 ;;
  bat-health) echo "$2" > /sys/bus/wmi/drivers/acer-wmi-battery/health_mode 2>/dev/null ;;
  bat-health-read) cat /sys/bus/wmi/drivers/acer-wmi-battery/health_mode 2>/dev/null || echo 0 ;;
  lcd-overdrive) python3 -c "f=open('/dev/ec','rb+');f.seek(0x29);f.write(bytes([int('$2')]));f.close()" 2>/dev/null ;;
  lcd-overdrive-read) python3 -c "f=open('/dev/ec','rb');f.seek(0x29);print(ord(f.read(1)));f.close()" 2>/dev/null ;;
  boot-anim) python3 -c "f=open('/dev/ec','rb+');v=1 if '$2'=='1' else 0;f.seek(0x1A);f.write(bytes([v]));f.close()" 2>/dev/null ;;
  boot-anim-read) python3 -c "f=open('/dev/ec','rb');f.seek(0x1A);print(ord(f.read(1)));f.close()" 2>/dev/null ;;
  usb-charge) python3 -c "f=open('/dev/ec','rb+');v=1 if '$2'=='1' else 0;f.seek(0x1B);f.write(bytes([v]));f.close()" 2>/dev/null ;;
  usb-charge-read) python3 -c "f=open('/dev/ec','rb');f.seek(0x1B);print(ord(f.read(1)));f.close()" 2>/dev/null ;;
  # PWM fan control via hwmon (kernel >= 6.14, models with ACER_CAP_PWM).
  # pwm value 0-255; pwm_enable: 0=max/turbo 1=manual/custom 2=auto.
  pwm-available) d=$(acer_hwmon) && echo 1 || echo 0 ;;
  pwm-cpu) d=$(acer_hwmon) && echo "$2" > "$d/pwm1" 2>/dev/null ;;
  pwm-gpu) d=$(acer_hwmon) && echo "$2" > "$d/pwm2" 2>/dev/null ;;
  pwm-cpu-read) d=$(acer_hwmon) && cat "$d/pwm1" 2>/dev/null ;;
  pwm-gpu-read) d=$(acer_hwmon) && cat "$d/pwm2" 2>/dev/null ;;
  pwm-cpu-enable) d=$(acer_hwmon) && echo "$2" > "$d/pwm1_enable" 2>/dev/null ;;
  pwm-gpu-enable) d=$(acer_hwmon) && echo "$2" > "$d/pwm2_enable" 2>/dev/null ;;
  pwm-cpu-enable-read) d=$(acer_hwmon) && cat "$d/pwm1_enable" 2>/dev/null ;;
  pwm-gpu-enable-read) d=$(acer_hwmon) && cat "$d/pwm2_enable" 2>/dev/null ;;
  # Re-applies the battery-limit settings the GUI persisted to config.json
  # (issue #11) - both mechanisms reset on a full power cycle and need
  # root, so this runs from a system-level (not user) boot service instead
  # of the interactive pkexec path the GUI uses. $2 = the real user's home.
  boot-reapply-battery)
    CONF="$2/.config/predator-sense/config.json"
    [ -f "$CONF" ] || exit 0
    LIMITER=$(python3 -c "import json;print(1 if json.load(open('$CONF')).get('battery_limiter') else 0)" 2>/dev/null)
    HEALTH=$(python3 -c "import json;print(1 if json.load(open('$CONF')).get('battery_health_mode') else 0)" 2>/dev/null)
    [ "$LIMITER" = "1" ] && { echo 80 > /sys/class/power_supply/BAT1/charge_control_end_threshold; } 2>/dev/null
    [ "$HEALTH" = "1" ] && { echo 1 > /sys/bus/wmi/drivers/acer-wmi-battery/health_mode; } 2>/dev/null
    exit 0
    ;;
  *) fail "unknown action '${1:-}'"; exit 1 ;;
esac
