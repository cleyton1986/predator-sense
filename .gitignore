# ══════════════════════════════════════
#  Predator Sense for Linux - .gitignore
# ══════════════════════════════════════

# Serena MCP local project data (memories, cache, per-machine config) -
# never intended to be shared upstream, keep it fully local.
.serena/

# === Rust build artifacts ===
predator-sense-gui/target/
predator-sense-gui/installer/target/
predator-sense-gui/protocol/target/
predator-sense-gui/protocol/Cargo.lock
predator-sense-gui/installer/predator-sense-installer
*.rlib
outros/

# POC only: Acer's proprietary Predator brand font, recovered during RE for
# local visual experiments (see predator-sense-gui/resources/fonts/README.md).
# Not licensed for redistribution - never commit these files without an
# explicit decision to accept that risk.
predator-sense-gui/resources/fonts/

# === Kernel module build artifacts ===
*.o
*.ko
*.obj
*.elf
*.mod
*.mod.c
*.mod.o
.*.cmd
.tmp_versions/
modules.order
Module.symvers

# === Compiled binaries ===
*.exe
*.out
*.app
*.so
*.dylib
*.dll

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
*~
.project
.cproject
.settings/

# === OS files ===
.DS_Store
Thumbs.db
*.tmp

# === Debug ===
*.dSYM/
*.su
*.idb
*.pdb

# === Misc ===
core
.depend
.docs
